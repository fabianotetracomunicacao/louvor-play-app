VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

VITE_SITE_URL=http://localhost:5173

# Public base URL used by the browser for suggestions, catalog and song detail.
# Keep the /api suffix: the client calls /artists/* below this URL.
VITE_CIFRA_API_URL=http://localhost:3000/api

# Server-only Edge Function configuration. Set these as Supabase Function
# secrets; do not prefix them with VITE_ and do not commit production values.
# Both catalog and individual cifra endpoints live below /api.
CIFRA_CATALOG_API_URL=http://localhost:3000/api
CIFRA_DETAIL_API_URL=http://localhost:3000/api

# Vercel server functions. Keep these out of browser bundles.
SUPABASE_SERVICE_ROLE_KEY=
OMNI_CHANNEL_ID=
OMNI_SECRET_KEY=
OMNI_WEBHOOK_SECRET=

# Optional Meta-approved utility template for invitations outside the 24-hour window.
OMNI_SCALE_TEMPLATE=
OMNI_SCALE_TEMPLATE_LANGUAGE=pt_BR
